# Base URL of the Blaze Hammer API.
#
# Empty (default in development):
#   Requests go to this Vite origin and are proxied to VITE_PROXY_TARGET
#   by the dev server (same-origin => session cookies just work, no CORS).
#
# Absolute URL:
#   The app calls the backend directly. This requires the backend to have
#   CORS enabled (web.cors.enabled: true with this exact origin) AND the
#   frontend/backend to share the same hostname (e.g. both "localhost" or
#   both "127.0.0.1") because the session cookie is SameSite=Strict.
VITE_API_BASE_URL=

# Dev-server-only proxy target used when VITE_API_BASE_URL is empty.
VITE_PROXY_TARGET=http://127.0.0.1:8080
